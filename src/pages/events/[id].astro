---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventWhen from '../../components/EventWhen.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatClock, formatEventDate, toDateIso } from '../../lib/events';
import { breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const hasRsvp = Boolean(event.data.rsvp);
const iso = toDateIso(event.data.date);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Events', href: '/events' },
  { name: event.data.title },
];

const description = `${event.data.title} — BitDevs DMV Socratic Seminar on ${formatEventDate(event.data.date)}. Technical Bitcoin reading room with primary sources.`;

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.data.title,
  startDate: iso,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: event.data.venue,
    address: event.data.venue,
  },
  organizer: {
    '@type': 'Organization',
    '@id': 'https://bitdevsdmv.com/#organization',
    name: 'BitDevs DMV',
    url: 'https://bitdevsdmv.com/',
  },
  url: `https://bitdevsdmv.com/events/${event.id}`,
  description,
  ...(hasRsvp
    ? {
        offers: {
          '@type': 'Offer',
          url: event.data.rsvp,
          price: 0,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<BaseLayout
  title={event.data.title}
  description={description}
  ogType="article"
  jsonLd={[eventJsonLd, breadcrumbJsonLd(crumbs)]}
>
  <section class="py-4 py-md-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
          <Breadcrumbs crumbs={crumbs} />

          <article class="reading-room p-4 p-md-5" itemscope itemtype="https://schema.org/Event">
            <meta itemprop="name" content={event.data.title} />
            <meta itemprop="startDate" content={iso} />
            <header class="event-head pb-4 mb-4">
              <p class="eyebrow mb-2">Reading room</p>
              <h1 class="display-6 mb-3">{event.data.title}</h1>

              <div class="meta-row d-flex flex-wrap column-gap-4 row-gap-2 mb-2 align-items-baseline">
                <span class="d-inline-flex flex-wrap align-items-baseline gap-2">
                  <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                  <EventWhen date={event.data.date} />
                </span>
                {
                  event.data.venue && (
                    <span>
                      <i class="fa-solid fa-location-dot me-1" aria-hidden="true" />
                      {event.data.venue}
                    </span>
                  )
                }
              </div>

              {
                (event.data.doors || event.data.seminar || event.data.depart) && (
                  <div class="meta-row d-flex flex-wrap column-gap-4 row-gap-2 mt-2">
                    {event.data.doors && (
                      <span>
                        <i class="fa-regular fa-clock me-1" aria-hidden="true" />
                        Doors {formatClock(event.data.doors)}
                      </span>
                    )}
                    {event.data.seminar && (
                      <span>
                        <i class="fa-solid fa-comments me-1" aria-hidden="true" />
                        Seminar {formatClock(event.data.seminar)}
                      </span>
                    )}
                    {event.data.depart && (
                      <span>
                        <i class="fa-solid fa-door-open me-1" aria-hidden="true" />
                        Depart {formatClock(event.data.depart)}
                      </span>
                    )}
                  </div>
                )
              }

              {
                event.data.tags.length > 0 && (
                  <div class="d-flex flex-wrap gap-1 mt-3">
                    {event.data.tags.map((tag) => (
                      <span class="badge rounded-pill badge-tag">{tag}</span>
                    ))}
                  </div>
                )
              }

              {
                hasRsvp && (
                  <div class="d-flex flex-wrap gap-2 mt-4">
                    <a
                      class="btn btn-primary"
                      href={event.data.rsvp}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <i class="fa-solid fa-ticket" aria-hidden="true" />
                      RSVP
                    </a>
                  </div>
                )
              }
            </header>

            <div class="prose">
              <Content />
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
