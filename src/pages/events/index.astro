---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import EventRow from '../../components/EventRow.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  allTags,
  formatEventDateLong,
  getHistoricalEvents,
  getPublishedEvents,
} from '../../lib/events';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/seo';

const events = await getPublishedEvents();
const tags = allTags(events);
const historical = getHistoricalEvents();
const publishedIds = new Set(events.map((e) => e.id));

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Events' },
];

const description =
  'Archive of BitDevs DMV Bitcoin Socratic Seminars — filter by tag and prepare from primary sources.';
---

<BaseLayout
  title="Events"
  description={description}
  jsonLd={[
    webPageJsonLd({
      title: 'Events',
      description,
      path: '/events',
      type: 'CollectionPage',
    }),
    breadcrumbJsonLd(crumbs),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs crumbs={crumbs} />
      <p class="section-kicker">Archive</p>
      <h1 class="display-5 mb-3">Events</h1>
      <p class="mb-3">
        Chronological archive of Socratic Seminars. Filter by tag to find past discussions on a
        theme, BIP, or stack. Times are Eastern (<span class="font-mono">ET</span>).
      </p>
      <p class="mb-0">
        <a class="back-link mb-0" href="/calendar.ics">
          <i class="fa-regular fa-calendar-plus" aria-hidden="true"></i>
          Subscribe to calendar (.ics)
        </a>
      </p>
    </div>
  </section>

  <section class="pb-5">
    <div class="container">
      <TagFilter tags={tags} />
      {
        events.length > 0 ? (
          <div class="list-group list-group-flush event-list">
            {events.map((event) => (
              <EventRow
                event={event}
                attrs={{
                  'data-event-tags': event.data.tags.map((t) => t.toLowerCase()).join(','),
                  'data-hidden': 'false',
                }}
              />
            ))}
          </div>
        ) : (
          <p class="font-mono text-muted-brand mb-0">No seminars published yet.</p>
        )
      }
    </div>
  </section>

  <section class="pb-5">
    <div class="container">
      <p class="section-kicker">Continuum</p>
      <h2 class="section-title mb-2">Chapter history</h2>
      <p class="text-muted-brand mb-4" style="max-width: 40rem;">
        Canonical registry of BitDevs DMV seminars. Entries with a reading room link to the page;
        others are placeholders until migrated here.
      </p>
      {
        historical.length > 0 ? (
          <ol class="history-list list-unstyled mb-0">
            {historical.map((item) => {
              const linked = item.slug && publishedIds.has(item.slug);
              const dateLabel = formatEventDateLong(new Date(`${item.date}T12:00:00.000Z`));
              return (
                <li class="history-item">
                  <span class="history-num font-mono">#{String(item.number).padStart(3, '0')}</span>
                  <div class="history-body">
                    {linked ? (
                      <a href={`/events/${item.slug}`}>{item.title}</a>
                    ) : (
                      <span>{item.title}</span>
                    )}
                    <span class="history-meta font-mono">{dateLabel}</span>
                    {item.notes && !linked && (
                      <span class="history-note text-muted-brand">{item.notes}</span>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="font-mono text-muted-brand mb-0">
            Registry is empty — add rows in <code>src/data/historical-events.json</code>.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
