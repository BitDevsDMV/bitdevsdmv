---
import '../styles/global.css';
import {
  DEFAULT_DESCRIPTION,
  SITE_NAME,
  organizationJsonLd,
  websiteJsonLd,
} from '../lib/seo';
import { TELEGRAM_HANDLE, TELEGRAM_URL } from '../lib/events';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  markdownPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
}

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  ogImage = '/brand/bitdevs-dmv-og.jpg',
  markdownPath,
  jsonLd,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const isHome = title === SITE_NAME;
const pageTitle = isHome
  ? `${SITE_NAME} — Bitcoin Socratic Seminars in DC, Maryland & Virginia`
  : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogImageUrl = new URL(ogImage, Astro.site).href;

function defaultMarkdownFor(pathname: string): string | undefined {
  if (pathname === '/about') return '/about.md';
  if (pathname === '/rules') return '/rules.md';
  if (pathname === '/contribute') return '/contribute.md';
  if (pathname === '/events') return '/events.md';
  if (pathname.startsWith('/events/')) return `${pathname}.md`;
  return undefined;
}

const mdHref = markdownPath ?? defaultMarkdownFor(path);

const structured = [
  organizationJsonLd(),
  websiteJsonLd(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="author" content="BitDevs DMV" />
    <meta name="theme-color" content="#07111f" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="describedby" type="text/markdown" title="llms.txt" href="/llms.txt" />
    {mdHref && <link rel="alternate" type="text/markdown" title="Markdown" href={mdHref} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/bitdevs-dmv-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="BitDevs DMV Events" href="/rss.xml" />
    <link rel="alternate" type="application/json" title="Events JSON" href="/events.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="BitDevs DMV logo" />
    <meta property="og:image:type" content="image/jpeg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="BitDevs DMV logo" />

    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <nav class="navbar navbar-expand-lg navbar-dark site-navbar sticky-top" aria-label="Primary">
        <div class="container py-1">
          <a class="navbar-brand d-inline-flex align-items-center" href="/">
            <img src="/brand/bitdevs-dmv-logo.png" alt="BitDevs DMV" width="36" height="36" />
            <span>BitDevs DMV</span>
          </a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#primaryNav"
            aria-controls="primaryNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="primaryNav">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
              <li class="nav-item">
                <a
                  class:list={['nav-link', path.startsWith('/events') && 'active']}
                  href="/events"
                  aria-current={path.startsWith('/events') ? 'page' : undefined}
                >
                  Events
                </a>
              </li>
              <li class="nav-item">
                <a
                  class:list={['nav-link', path === '/about' && 'active']}
                  href="/about"
                  aria-current={path === '/about' ? 'page' : undefined}
                >
                  About
                </a>
              </li>
              <li class="nav-item">
                <a
                  class:list={['nav-link', path === '/rules' && 'active']}
                  href="/rules"
                  aria-current={path === '/rules' ? 'page' : undefined}
                >
                  Ground rules
                </a>
              </li>
              <li class="nav-item">
                <a
                  class:list={['nav-link', path === '/contribute' && 'active']}
                  href="/contribute"
                  aria-current={path === '/contribute' ? 'page' : undefined}
                >
                  Suggest topics
                </a>
              </li>
            </ul>
          </div>
        </div>
      </nav>

      <main id="main" class="site-main">
        <slot />
      </main>

      <footer class="site-footer py-5 mt-auto">
        <div class="container">
          <div class="row g-4 align-items-start">
            <div class="col-lg-6">
              <div class="d-flex align-items-center gap-3 mb-3">
                <img src="/brand/bitdevs-dmv-logo.png" alt="" width="40" height="40" />
                <strong>BitDevs DMV</strong>
              </div>
              <p class="mb-0 text-muted-brand">
                Technical Socratic seminars for Bitcoin protocol research in DC, Maryland &amp;
                Virginia.
              </p>
            </div>
            <div class="col-lg-6">
              <div class="d-flex flex-wrap gap-4 justify-content-lg-end">
                <a href={TELEGRAM_URL} rel="noopener noreferrer">
                  <i class="fa-brands fa-telegram me-2" aria-hidden="true"></i>{TELEGRAM_HANDLE}
                </a>
                <a href="/calendar.ics">
                  <i class="fa-regular fa-calendar-plus me-2" aria-hidden="true"></i>Calendar
                </a>
                <a href="/rss.xml"><i class="fa-solid fa-rss me-2" aria-hidden="true"></i>RSS</a>
                <a href="/rules"><i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>Ground rules</a>
                <a href="https://www.bitdevsmap.org/" rel="noopener noreferrer">
                  <i class="fa-solid fa-map-location-dot me-2" aria-hidden="true"></i>Other chapters
                </a>
              </div>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>
    <script>
      function relativeFromIso(iso: string, now = new Date()): string {
        const [y, m, d] = iso.split('-').map(Number);
        const target = Date.UTC(y, m - 1, d);
        const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        const deltaDays = Math.round((target - today) / 86_400_000);

        if (deltaDays === 0) return 'today';
        if (deltaDays === 1) return 'tomorrow';
        if (deltaDays === -1) return 'yesterday';

        const abs = Math.abs(deltaDays);
        const ahead = deltaDays > 0;
        const unit = (count: number, one: string, many: string) =>
          `${count} ${count === 1 ? one : many}`;

        let amount: string;
        if (abs < 14) amount = unit(abs, 'day', 'days');
        else if (abs < 60) amount = unit(Math.round(abs / 7), 'week', 'weeks');
        else if (abs < 730) amount = unit(Math.round(abs / 30.437), 'month', 'months');
        else amount = unit(Math.round(abs / 365.25), 'year', 'years');

        return ahead ? `in ${amount}` : `${amount} ago`;
      }

      function refreshRelativeDates() {
        for (const el of document.querySelectorAll<HTMLElement>('[data-relative-date]')) {
          const iso = el.dataset.relativeDate;
          if (!iso) continue;
          el.textContent = relativeFromIso(iso);
        }
      }

      refreshRelativeDates();
    </script>
  </body>
</html>
