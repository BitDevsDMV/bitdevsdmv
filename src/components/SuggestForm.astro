---
interface Props {
  apiUrl: string;
}

const { apiUrl } = Astro.props;

const sections = [
  '',
  'Announcements',
  'Mailing Lists, Meetings and Bitcoin Optech',
  'Network Data',
  'Research',
  'InfoSec',
  'Pull Requests and repo updates',
  'New Releases',
  'Mining',
  'Miscellaneous',
];
---

<form class="suggest-form" data-suggest-form data-api={apiUrl} novalidate>
  <div class="row g-3">
    <div class="col-12">
      <label class="form-label" for="suggest-title">Title</label>
      <input
        class="form-control"
        id="suggest-title"
        name="title"
        type="text"
        required
        minlength="3"
        maxlength="200"
        placeholder="e.g. Cluster mempool spanning-forest linearization"
        autocomplete="off"
      />
    </div>

    <div class="col-12">
      <label class="form-label" for="suggest-url">Primary source URL</label>
      <input
        class="form-control"
        id="suggest-url"
        name="url"
        type="url"
        required
        maxlength="2000"
        placeholder="https://…"
        autocomplete="off"
      />
      <div class="form-text">Link the PR, paper, advisory, or post itself — not a summary thread.</div>
    </div>

    <div class="col-md-6">
      <label class="form-label" for="suggest-section">Section (optional)</label>
      <select class="form-select" id="suggest-section" name="section">
        {sections.map((section) => (
          <option value={section}>{section || 'Unspecified'}</option>
        ))}
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label" for="suggest-contact">Contact (optional)</label>
      <input
        class="form-control"
        id="suggest-contact"
        name="contact"
        type="text"
        maxlength="200"
        placeholder="npub… / email / handle"
        autocomplete="off"
      />
    </div>

    <div class="col-12">
      <label class="form-label" for="suggest-why">Why it matters (optional)</label>
      <textarea
        class="form-control"
        id="suggest-why"
        name="why"
        rows="3"
        maxlength="500"
        placeholder="One or two sentences for the hosts."
      ></textarea>
    </div>

    {/* Honeypot */}
    <div class="suggest-hp" aria-hidden="true">
      <label for="suggest-website">Website</label>
      <input id="suggest-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="col-12 d-flex flex-wrap align-items-center gap-3">
      <button class="btn btn-primary" type="submit" data-suggest-submit>
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        Send suggestion
      </button>
      <p class="mb-0 small text-muted-on-paper" data-suggest-status role="status" aria-live="polite"></p>
    </div>
  </div>
</form>

<style>
  .suggest-form .form-label {
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--paper-ink);
  }

  .suggest-form .form-control,
  .suggest-form .form-select {
    background: #fff;
    border-color: rgba(16, 24, 32, 0.18);
    color: var(--paper-ink);
  }

  .suggest-form .form-control:focus,
  .suggest-form .form-select:focus {
    border-color: var(--signal);
    box-shadow: 0 0 0 0.2rem rgba(247, 147, 26, 0.25);
  }

  .suggest-form .form-text,
  .text-muted-on-paper {
    color: var(--muted-on-paper) !important;
  }

  .suggest-hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .suggest-form [data-suggest-status].is-error {
    color: #a33 !important;
  }

  .suggest-form [data-suggest-status].is-ok {
    color: #1f6b3a !important;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-suggest-form]');
  if (form) {
    const api = form.dataset.api || '';
    const status = form.querySelector<HTMLElement>('[data-suggest-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-suggest-submit]');

    const setStatus = (message: string, kind: 'ok' | 'error' | '') => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-ok', kind === 'ok');
      status.classList.toggle('is-error', kind === 'error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!api) {
        setStatus('Suggestion API is not configured.', 'error');
        return;
      }

      const data = new FormData(form);
      const payload = {
        title: String(data.get('title') || '').trim(),
        url: String(data.get('url') || '').trim(),
        why: String(data.get('why') || '').trim(),
        section: String(data.get('section') || '').trim(),
        contact: String(data.get('contact') || '').trim(),
        website: String(data.get('website') || '').trim(),
      };

      if (submit) submit.disabled = true;
      setStatus('Sending…', '');

      try {
        const res = await fetch(`${api.replace(/\/$/, '')}/suggest`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = (await res.json()) as { ok?: boolean; error?: string };
        if (!res.ok || !json.ok) {
          setStatus(json.error || 'Could not send suggestion.', 'error');
        } else {
          form.reset();
          setStatus('Thanks — organizers will see it for the next seminar.', 'ok');
        }
      } catch {
        setStatus('Network error. Try again in a moment.', 'error');
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
